# Settings for the Compose stack (infra/compose.yaml), read from infra/.env. `pnpm supabase:env`
# creates that file from this one and fills in the Supabase key. Never commit infra/.env.
# A setting left empty or commented out takes the default shown, which suits the local stack.

# Uploaded files go to Supabase Storage; without a secret key the API stops at start-up.
# A hosted project: its URL and a secret key (Project Settings → API Keys).
SUPABASE_SECRET_KEY=
# SUPABASE_URL=http://host.docker.internal:54321
# SUPABASE_STORAGE_BUCKET=datasets

# The database: the local Supabase stack's Postgres. A hosted project: the "Session pooler"
# connection string (without sslmode), DATABASE_SSL=verify and DATABASE_SSL_CA set to the
# project's CA certificate (PEM text).
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
# DATABASE_SSL=disable
# DATABASE_SSL_CA=

# The password demo accounts get when first seeded. Use your own for any shared deployment.
# SEED_USER_PASSWORD=Emirates-Demo-2026
# "true" behind HTTPS (any hosted deployment); the plain-HTTP local stack only works with "false".
# COOKIE_SECURE=false

# AI is optional: without keys, rules are drafted from their own words and suggested fixes use
# standard wording. The API and the AI service share this token (16 characters or more).
# AI_SERVICE_TOKEN=compose-local-token-0123456789
# TypeSafe Jev drafts rules and suggests owner teams.
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-1.13.0
# Claude on Microsoft Foundry writes suggested fixes. It needs a key and the Foundry resource's
# name (a URL on the resource works too); ANTHROPIC_FOUNDRY_BASE_URL can name the Anthropic
# endpoint instead (https://<resource>.services.ai.azure.com/anthropic/).
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
# ANTHROPIC_FOUNDRY_BASE_URL=
# FOUNDRY_HAIKU_DEPLOYMENT=claude-haiku-5-5
