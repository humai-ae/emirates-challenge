{
  "name": "hr-compliance-checker",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
