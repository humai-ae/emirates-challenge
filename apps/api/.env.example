PORT=3000
# The local Supabase stack's Postgres (`supabase start`; `pnpm supabase:env` fills in this file).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted database (Supabase): set DATABASE_URL to the project's "Session pooler" connection
# string (without sslmode), DATABASE_SSL=verify and DATABASE_SSL_CA to the project's CA
# certificate (PEM text).
DATABASE_SSL=disable
AUTH_MODE=password
# The password seeded demo accounts get (db:seed). Use your own for any shared deployment.
SEED_USER_PASSWORD=Emirates-Demo-2026
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
AI_SERVICE_URL=http://localhost:3100
AI_SERVICE_TOKEN=dev-only-token-change-me-0123456789
